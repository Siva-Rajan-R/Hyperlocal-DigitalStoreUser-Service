PORT=8011
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=DigitalStoreUserServiceDb
ENVIRONMENT=development

# Inter-service URLs (for local runner.py)
SHOP_SERVICE_URL=http://127.0.0.1:8001
ORDER_SERVICE_URL=http://127.0.0.1:8007
INVENTORY_SERVICE_URL=http://127.0.0.1:8004

# Inter-service URLs for Docker (uncomment or set via docker-compose environment)
# SHOP_SERVICE_URL=http://shopemp-service:8000
# ORDER_SERVICE_URL=http://order-service:8000
# INVENTORY_SERVICE_URL=http://inventory-service:8000

# Subscription Mock Testing (set to true to test full cutoff & expiry banner)
MOCK_SUBSCRIPTION_EXPIRED="false"

MOCK_TRIAL_EXPIRED="false"
